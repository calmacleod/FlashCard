<div id="flashcard-status">
<% case document.processing_status
   when "processing"
     p = document.progress
     stage = p["stage"].to_s %>
  <div class="fc-progress">
    <%# Stage pipeline %>
    <div class="fc-pipeline">
      <% stages = [
           ["extracting_text",      "Extract text"],
           ["processing_chunks",    "Process chunks"],
           ["assembling",           "Assemble"],
           ["normalizing",          "Normalise"],
           ["generating_flashcards","Generate cards"],
           ["indexing",             "Index for search"],
           ["importing",            "Import"]
         ]
         current_idx = stages.index { |s, _| s == stage } || 0
      %>
      <% stages.each_with_index do |(key, label), i| %>
        <% state = i < current_idx ? :done : i == current_idx ? :active : :pending %>
        <div class="fc-pipeline__step fc-pipeline__step--<%= state %>">
          <span class="fc-pipeline__dot"></span>
          <span class="fc-pipeline__label"><%= label %></span>
        </div>
        <% if i < stages.size - 1 %>
          <div class="fc-pipeline__line fc-pipeline__line--<%= i < current_idx ? :done : :pending %>"></div>
        <% end %>
      <% end %>
    </div>

    <%# Detail rows %>
    <div class="fc-progress__details">

      <% if stage == "processing_chunks" || (p["chunks_total"].to_i > 0 && current_idx > 1) %>
        <% total = p["chunks_total"].to_i; done = p["chunks_done"].to_i %>
        <% if total > 0 %>
          <div class="fc-stat-row">
            <span class="fc-stat-row__label">Chunks extracted</span>
            <span class="fc-stat-row__value"><%= done %> / <%= total %></span>
          </div>
          <div class="fc-bar">
            <div class="fc-bar__fill" style="width:<%= (done * 100.0 / total).round %>%"></div>
          </div>
        <% end %>
      <% end %>

      <% articles = p["articles_extracted"].to_i %>
      <% if articles > 0 %>
        <div class="fc-stat-row" style="margin-top: 8px;">
          <span class="fc-stat-row__label">Articles extracted</span>
          <span class="fc-stat-row__value"><%= articles %></span>
        </div>
      <% end %>

      <% if stage == "generating_flashcards" %>
        <% gtotal = p["groups_total"].to_i; gdone = p["groups_done"].to_i; cards = p["flashcards_done"].to_i %>
        <% if gtotal > 0 %>
          <div class="fc-stat-row" style="margin-top: 8px;">
            <span class="fc-stat-row__label">Flashcards generated</span>
            <span class="fc-stat-row__value"><%= cards %> (<%= gdone %>/<%= gtotal %> groups)</span>
          </div>
          <div class="fc-bar">
            <div class="fc-bar__fill fc-bar__fill--cards" style="width:<%= (gdone * 100.0 / gtotal).round %>%"></div>
          </div>
        <% end %>
      <% end %>

      <% if stage == "indexing" %>
        <% etotal = p["entries_total"].to_i; eindexed = p["entries_indexed"].to_i %>
        <% if etotal > 0 %>
          <div class="fc-stat-row" style="margin-top: 8px;">
            <span class="fc-stat-row__label">Entries indexed</span>
            <span class="fc-stat-row__value"><%= eindexed %> / <%= etotal %></span>
          </div>
          <div class="fc-bar">
            <div class="fc-bar__fill fc-bar__fill--index" style="width:<%= (eindexed * 100.0 / etotal).round %>%"></div>
          </div>
        <% end %>
      <% end %>

    </div>
  </div>

<% when "failed" %>
  <div class="flashcard-status flashcard-status--failed">
    Generation failed: <%= document.processing_error.presence || "unknown error" %>
  </div>

<% when "completed" %>
  <div class="flashcard-status flashcard-status--completed">
    <%= link_to "#{document.flashcards.count} flashcards ready →", document_flashcards_path(document), class: "link" %>
  </div>

<% end %>
</div>
