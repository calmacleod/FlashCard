<div id="flashcard-status">
  <% case document.processing_status %>
  <% when "processing" %>
    <% progress = document.progress %>
    <% done = progress["groups_done"].to_i %>
    <% total = progress["groups_total"].to_i %>
    <div class="flashcard-status flashcard-status--processing">
      <span class="flashcard-status__spinner"></span>
      <%= progress["stage"] == "queued" ? "Waiting to generate flashcards…" : "Generating flashcards…" %>
    </div>
    <% if total.positive? %>
      <div class="fc-progress__details" style="margin-top: 10px;">
        <div class="fc-stat-row">
          <span class="fc-stat-row__label">Source groups processed</span>
          <span class="fc-stat-row__value"><%= done %> / <%= total %></span>
        </div>
        <div class="fc-bar">
          <div class="fc-bar__fill fc-bar__fill--cards" style="width:<%= (done * 100.0 / total).round %>%"></div>
        </div>
        <div class="fc-stat-row">
          <span class="fc-stat-row__label">Cards generated</span>
          <span class="fc-stat-row__value"><%= progress["flashcards_done"].to_i %></span>
        </div>
      </div>
    <% end %>
  <% when "failed" %>
    <div class="flashcard-status flashcard-status--failed">
      Generation failed: <%= document.processing_error.presence || "unknown error" %>
    </div>
  <% when "completed" %>
    <div class="flashcard-status flashcard-status--completed">
      <%= link_to "#{document.flashcards.count} flashcards ready →", document_flashcards_path(document), class: "link" %>
    </div>
  <% end %>
</div>
