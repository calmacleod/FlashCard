<% content_for :title, @document.name %>

<div class="page">
  <div class="headline">
    <div>
      <h1><%= @document.name %></h1>
      <% if @document.description.present? %>
        <p><%= @document.description %></p>
      <% end %>
    </div>
    <%= link_to "← Back to Documents", documents_path, class: "link" %>
  </div>

  <div class="stack">
  <div class="card">
    <% if @document.file.attached? %>
      <div class="document-toolbar" style="margin-bottom: 16px;">
        <div>
          <span class="badge"><%= @document.file.content_type == "application/pdf" ? "PDF" : "TXT" %></span>
          &ensp;
          <%= link_to @document.file.filename, rails_blob_path(@document.file, disposition: :attachment), class: "link" %>
        </div>
        <p class="meta">Uploaded <%= @document.created_at.strftime("%B %-d, %Y at %-I:%M %p") %></p>
      </div>

      <% if @document.file.content_type == "application/pdf" %>
        <details class="pdf-viewer">
          <summary class="pdf-viewer__toggle">View PDF</summary>
          <iframe
            src="<%= rails_blob_path(@document.file, disposition: :inline) %>"
            class="pdf-viewer__frame"
            title="<%= @document.name %>">
          </iframe>
        </details>
      <% elsif @document.file.content_type == "text/plain" %>
        <pre class="text-preview"><%= @document.file.download %></pre>
      <% end %>
    <% else %>
      <p class="meta">No file attached.</p>
    <% end %>

    <div class="actions" style="margin-top: 16px;">
      <%= link_to "Edit Schema", edit_document_path(@document), class: "btn btn--ghost" %>
      <%= button_to "Delete Document", document_path(@document), method: :delete,
            class: "btn btn--ghost",
            style: "color: var(--danger-text);",
            data: { turbo_confirm: "Delete \"#{@document.name}\"? This cannot be undone." } %>
    </div>
  </div>

  <%= turbo_stream_from "document_#{@document.id}_status" %>

  <div class="card">
      <div class="section-heading" style="margin-bottom: 12px;">
        <strong>Extraction Schema</strong>
        <div class="actions" style="margin-top: 0;">
          <%= link_to "Edit settings", edit_document_path(@document), class: "btn btn--sm btn--ghost" %>
          <%= button_to "Regenerate", generate_schema_document_path(@document), method: :post,
                class: "btn btn--sm btn--ghost", disabled: %w[queued generating].include?(@document.schema_generation_status) %>
        </div>
      </div>
      <% if %w[queued generating].include?(@document.schema_generation_status) %>
        <p class="flashcard-status flashcard-status--processing"><span class="flashcard-status__spinner"></span>Generating schema…</p>
      <% elsif @document.schema_generation_status == "failed" %>
        <div class="alert">Schema generation failed: <%= @document.schema_generation_error %></div>
      <% elsif @document.extraction_schema.present? %>
        <pre class="code-block"><%= JSON.pretty_generate(@document.extraction_schema_hash) %></pre>
      <% else %>
        <p class="meta">No extraction schema has been generated yet.</p>
      <% end %>
  </div>

  <div class="card">
    <% extraction = @document.latest_extraction %>
    <div class="section-heading" style="margin-bottom: 12px;">
      <div>
        <strong>Extracted Data</strong>
        <% if extraction %>
          <span class="badge" style="margin-left: 8px;"><%= extraction.status.titleize %></span>
        <% end %>
      </div>
      <div class="actions" style="margin-top: 0;">
        <% if extraction&.completed? %>
          <%= link_to "Download JSON", download_document_extraction_path(@document, extraction, format: :json), class: "btn btn--sm btn--ghost" %>
          <%= link_to "Download CSV", download_document_extraction_path(@document, extraction, format: :csv), class: "btn btn--sm btn--ghost" %>
        <% end %>
        <%= button_to extraction&.completed? ? "Extract again" : "Extract data",
              document_extractions_path(@document), method: :post,
              class: "btn btn--sm",
              disabled: @document.extraction_schema_hash.nil? || extraction&.active?,
              data: { turbo_confirm: extraction&.completed? ? "Run a new extraction using the current schema?" : nil } %>
      </div>
    </div>

    <%= render "documents/extraction_status", extraction: extraction %>

    <% if @document.extraction_schema_hash.nil? %>
      <p class="meta">Generate or enter an extraction schema before extracting data.</p>
    <% elsif extraction.nil? %>
      <p class="meta">Run extraction to turn this document into structured data using the schema above.</p>
    <% end %>
  </div>

  <div class="card">
    <div class="section-heading" style="margin-bottom: 12px;">
      <div>
        <strong>Flashcards</strong>
        <% if @document.flashcards.any? %>
          <span class="badge" style="margin-left: 8px;"><%= @document.flashcards.count %> cards</span>
        <% end %>
      </div>
      <% if @document.flashcards.any? %>
        <%= link_to "Study cards", document_flashcards_path(@document), class: "btn btn--sm btn--ghost" %>
      <% end %>
    </div>
    <p class="meta">Choose how the model should turn the latest completed extraction into study questions.</p>
    <%= render "documents/flashcard_generation_form",
          document: @document,
          disabled: @document.latest_completed_extraction.nil? || @document.processing_status == "processing" %>
    <% unless @document.latest_completed_extraction %>
      <p class="hint">Complete data extraction before generating flashcards.</p>
    <% end %>
    <div style="margin-top: 12px;">
      <%= render "documents/flashcard_status", document: @document %>
    </div>
  </div>
  </div>
</div>
