<% content_for :title, @document.name %>

<div class="page">
  <div class="headline">
    <div>
      <h1><%= @document.name %></h1>
      <% if @document.description.present? %>
        <p><%= @document.description %></p>
      <% end %>
    </div>
    <%= link_to "← Back to Documents", documents_path, class: "link" %>
  </div>

  <div class="card">
    <% if @document.file.attached? %>
      <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin-bottom: 16px;">
        <div>
          <span class="badge"><%= @document.file.content_type == "application/pdf" ? "PDF" : "TXT" %></span>
          &ensp;
          <%= link_to @document.file.filename, rails_blob_path(@document.file, disposition: :attachment), class: "link" %>
        </div>
        <p class="meta" style="margin: 0;">Uploaded <%= @document.created_at.strftime("%B %-d, %Y at %-I:%M %p") %></p>
      </div>

      <% if @document.file.content_type == "application/pdf" %>
        <details class="pdf-viewer">
          <summary class="pdf-viewer__toggle">View PDF</summary>
          <iframe
            src="<%= rails_blob_path(@document.file, disposition: :inline) %>"
            class="pdf-viewer__frame"
            title="<%= @document.name %>">
          </iframe>
        </details>
      <% elsif @document.file.content_type == "text/plain" %>
        <pre style="white-space: pre-wrap; word-break: break-word; background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius); padding: 16px; font-size: 13px; line-height: 1.6; max-height: 80vh; overflow-y: auto;"><%= @document.file.download %></pre>
      <% end %>
    <% else %>
      <p class="meta">No file attached.</p>
    <% end %>

    <div class="actions" style="margin-top: 16px;">
      <%= link_to "Edit Schema", edit_document_path(@document), class: "btn btn--ghost" %>
      <%= button_to "Delete Document", document_path(@document), method: :delete,
            class: "btn btn--ghost",
            style: "color: var(--danger-text);",
            data: { turbo_confirm: "Delete \"#{@document.name}\"? This cannot be undone." } %>
    </div>
  </div>

  <% if @document.extraction_schema.present? %>
    <div class="card" style="margin-top: 18px;">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
        <strong>Extraction Schema</strong>
        <%= link_to "Edit", edit_document_path(@document), class: "link", style: "font-size: 13px;" %>
      </div>
      <pre style="margin: 0; background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 14px; font-size: 12px; line-height: 1.55; overflow: auto; max-height: 320px; font-family: var(--font-mono); white-space: pre;"><%= JSON.pretty_generate(@document.extraction_schema_hash) %></pre>
    </div>
  <% end %>
</div>
