<% content_for :title, "Upload Document" %>

<div class="page">
  <div class="headline">
    <div>
      <h1>Upload Document</h1>
      <p>Add a PDF or plain text file to the library.</p>
    </div>
    <%= link_to "← Back to Documents", documents_path, class: "link" %>
  </div>

  <div class="card">
    <%= form_with model: @document, multipart: true do |f| %>
      <% if @document.errors.any? %>
        <div class="alert" style="margin-bottom: 16px;">
          <% @document.errors.full_messages.each do |msg| %>
            <div><%= msg %></div>
          <% end %>
        </div>
      <% end %>

      <div class="form-grid">
        <div>
          <%= f.label :name, "Name" %>
          <%= f.text_field :name, placeholder: "e.g. 2024 Official Rulebook" %>
        </div>

        <div>
          <%= f.label :description, "Description (optional)" %>
          <%= f.text_area :description, placeholder: "Brief description of this document..." %>
        </div>

        <div>
          <%= f.label :file, "File" %>
          <%= f.file_field :file, accept: "application/pdf,text/plain" %>
          <p class="hint">Accepted formats: PDF, plain text (.txt)</p>
        </div>

        <%= render "model_setting", document: @document, context: :schema,
              models: @structured_models, title: "Automatic schema generation",
              description: "A schema will be proposed after upload. You can review and edit it before extraction." %>

        <div class="actions" style="margin-top: 0;">
          <%= f.submit "Upload Document", class: "btn" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
