<div class="message message--<%= message.role %>">
  <div class="message__role"><%= message.role == "user" ? "You" : "Agent" %></div>
  <% if message.role.to_s == "assistant" && message.thinking_text.present? %>
    <details class="message__thinking-block">
      <summary class="message__thinking-summary">Thinking</summary>
      <div class="message__thinking-text"><%= simple_format(message.thinking_text) %></div>
    </details>
  <% end %>
  <div class="message__content"><%= markdown(message.content) %></div>
</div>
