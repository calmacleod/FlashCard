<% content_for :sidebar_extra do %>
  <div class="sidebar-section">
    <span class="sidebar-label">Conversations</span>
    <%= form_with url: new_rule_agent_chat_path, method: :post do %>
      <button type="submit" class="btn btn--ghost btn--sm chat-history__new-btn">+ New conversation</button>
    <% end %>
    <% if @past_chats.any? %>
      <nav class="chat-history" aria-label="Past conversations">
        <% @past_chats.each do |chat| %>
          <%= link_to rule_agent_path(chat: chat.session_token), class: "chat-history__item" do %>
            <span class="chat-history__title"><%= chat.title.presence || "Untitled" %></span>
            <span class="chat-history__date"><%= chat.updated_at.strftime("%-d %b") %></span>
          <% end %>
        <% end %>
      </nav>
    <% end %>
  </div>
<% end %>

<%= turbo_stream_from "rule_agent_#{@chat.id}" %>
<div class="rule-agent" data-controller="rule-agent rule-preview"
     data-rule-agent-token-value="<%= @chat.session_token %>"
     data-rule-preview-url-value="<%= rule_search_preview_path %>">
  <div class="rule-agent__header">
    <h1>Rule Agent</h1>
    <div class="rule-agent__controls">
      <button type="button" class="btn btn--ghost btn--sm"
              data-action="rule-agent#toggleFullscreen"
              data-rule-agent-target="fullscreenBtn"
              aria-label="Toggle fullscreen">Fullscreen</button>
      <%= form_with url: rule_agent_path, method: :delete, data: { turbo_confirm: "Delete this conversation?" } do %>
        <button type="submit" class="btn btn--ghost btn--sm"
                data-action="rule-agent#clearStorage">Delete</button>
      <% end %>
    </div>
  </div>

  <div class="rule-agent__messages" id="messages" data-rule-agent-target="messages">
    <% if @messages.empty? %>
      <p class="rule-agent__empty">Ask a question about the rulebook to get started.</p>
    <% end %>
    <% @messages.each do |msg| %>
      <%= render "message", message: msg %>
    <% end %>
    <% if @processing %>
      <div id="thinking_<%= @chat.id %>" class="message message--assistant message--thinking">
        <div class="message__role">Agent</div>
        <div class="message__content message__thinking"><span></span><span></span><span></span></div>
      </div>
    <% end %>
  </div>

  <%= render "token_usage", tokens: @tokens %>

  <div class="rule-preview-modal" data-rule-preview-target="modal" aria-hidden="true">
    <div class="rule-preview-modal__backdrop" data-action="click->rule-preview#close"></div>
    <div class="rule-preview-modal__dialog">
      <button class="rule-preview-modal__close" data-action="click->rule-preview#close" aria-label="Close">✕</button>
      <div class="rule-preview-modal__body" data-rule-preview-target="body">
        <p class="rule-preview__loading">Loading…</p>
      </div>
    </div>
  </div>

  <div class="rule-agent__form">
    <%= form_with url: rule_agent_messages_path,
                  data: { turbo_stream: true, action: "submit->rule-agent#onSubmit turbo:submit-end->rule-agent#onSubmitEnd", rule_agent_target: "form" } do |f| %>
      <% thinking = LlmModelCatalog.tool_thinking_configuration(@selected_model) %>
      <div class="rule-agent__selects" data-controller="model-settings"
           data-model-settings-configurations-value="<%= @thinking_configurations.to_json %>">
        <%= select_tag :source_csv, options_for_select(@sources.map { |s| [File.basename(s), s] }, @source),
              class: "rule-agent__source-select" %>
        <%= select_tag :model,
              options_for_select(@agent_models.map { |model| [model.label, model.key] }, @selected_model),
              class: "rule-agent__source-select",
              aria: { label: "Model" },
              data: { model_settings_target: "model", action: "change->model-settings#refresh" } %>
        <label class="rule-agent__thinking" data-model-settings-target="effortField"
               <%= "hidden" unless thinking[:mode] == "effort" %>>
          <span>Effort</span>
          <%= select_tag :thinking_effort,
                options_for_select([["Default", ""]] + thinking[:efforts].map { |value| [value, value] }),
                disabled: thinking[:mode] != "effort", class: "rule-agent__source-select",
                data: { model_settings_target: "effort" } %>
        </label>
        <label class="rule-agent__thinking" data-model-settings-target="budgetField"
               <%= "hidden" unless thinking[:mode] == "budget" %>>
          <span>Budget</span>
          <%= number_field_tag :thinking_budget, nil, min: 0, max: 65_536,
                disabled: thinking[:mode] != "budget", placeholder: "Default",
                data: { model_settings_target: "budget" } %>
        </label>
        <span class="visually-hidden" data-model-settings-target="hint"></span>
      </div>
      <div class="rule-agent__input-row">
        <%= f.text_area :message,
              placeholder: "Ask about the rulebook… (Enter to send, Shift+Enter for newline)",
              rows: 2,
              data: { rule_agent_target: "input", action: "keydown->rule-agent#submitOnEnter" } %>
        <%= f.submit "Send", class: "btn", data: { rule_agent_target: "submit" } %>
      </div>
    <% end %>
  </div>
</div>
