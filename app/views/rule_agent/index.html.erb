<div class="rule-agent" data-controller="rule-agent">
  <div class="rule-agent__header">
    <h1>Rule Agent</h1>
    <div class="rule-agent__controls">
      <%= form_with url: rule_agent_path, method: :delete, data: { turbo_confirm: "Clear conversation?" } do %>
        <button type="submit" class="btn btn--ghost btn--sm">Clear</button>
      <% end %>
    </div>
  </div>

  <div class="rule-agent__messages" id="messages" data-rule-agent-target="messages">
    <% if @messages.empty? %>
      <p class="rule-agent__empty">Ask a question about the rulebook to get started.</p>
    <% end %>
    <% @messages.each do |msg| %>
      <%= render "message", message: msg %>
    <% end %>
  </div>

  <%= render "token_usage", tokens: @tokens %>

  <div class="rule-agent__form">
    <%= form_with url: rule_agent_messages_path,
                  data: { turbo_stream: true, action: "turbo:submit-end->rule-agent#onSubmitEnd", rule_agent_target: "form" } do |f| %>
      <div class="rule-agent__selects">
        <%= select_tag :source_csv, options_for_select(@sources.map { |s| [File.basename(s), s] }, @source),
              class: "rule-agent__source-select" %>
        <%= select_tag :model, options_for_select([
              ["gemini-2.5-flash-lite", "gemini-2.5-flash-lite"],
              ["gemini-2.0-flash",      "gemini-2.0-flash"],
              ["gemini-2.5-flash",      "gemini-2.5-flash"],
            ], params[:model] || "gemini-2.5-flash-lite"),
              class: "rule-agent__source-select" %>
      </div>
      <div class="rule-agent__input-row">
        <%= f.text_area :message,
              placeholder: "Ask about the rulebook… (Enter to send, Shift+Enter for newline)",
              rows: 2,
              data: { rule_agent_target: "input", action: "keydown->rule-agent#submitOnEnter" } %>
        <%= f.submit "Send", class: "btn", data: { rule_agent_target: "submit" } %>
      </div>
    <% end %>
  </div>
</div>
