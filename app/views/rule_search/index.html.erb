<div style="max-width: 1100px; margin: 0 auto; padding: 2rem;">
  <div class="headline">
    <h1>Rule Search</h1>
  </div>

  <%= form_with url: rule_search_search_path, method: :get, data: { turbo: false } do |f| %>
    <div class="card" style="margin-bottom: 1.5rem;">
      <div class="form-grid">
        <div>
          <%= f.label :query, "Search query" %>
          <%= f.text_field :query, value: params[:query], placeholder: "e.g. player substitution rules", required: true %>
        </div>

        <div>
          <%= f.label :source_csv, "Filter by rulebook" %>
          <%= f.select :source_csv,
              options_for_select([["All rulebooks", ""]] + @source_csvs.map { |c| [File.basename(c), c] }, params[:source_csv]) %>
        </div>

        <%= f.submit "Search", class: "btn" %>
      </div>
    </div>
  <% end %>

  <% if @results&.any? %>
    <p class="meta" style="margin-bottom: 1rem; font-size: 13px;"><%= @results.size %> result<%= @results.size == 1 ? "" : "s" %></p>
    <div class="card-list">
      <% @results.each do |result| %>
        <div class="card-item">
          <% parts = [result[:rule_number], result[:section], result[:article]].compact.reject(&:empty?) %>
          <% if parts.any? %>
            <p class="card-item__label" style="font-size: 16px; text-transform: none; letter-spacing: 0; font-weight: 700; color: var(--text);">
              <%= parts.join(" › ") %>
            </p>
          <% end %>
          <p class="card-item__content" style="white-space: pre-wrap; line-height: 1.6;"><%= result[:text] %></p>
        </div>
      <% end %>
    </div>
  <% elsif params[:query].present? %>
    <p class="meta">No results found.</p>
  <% end %>
</div>
