<div class="min-h-screen bg-gray-100 py-10">
  <div style="max-width: 700px; margin: 0 auto; padding: 0 2rem;">
    <h1 class="text-2xl font-bold mb-8 text-gray-800">Rule Search</h1>

    <%= form_with url: rule_search_search_path, method: :get, data: { turbo: false }, class: "bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-8 space-y-4" do |f| %>
      <div>
        <%= f.label :query, "Search query", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :query, value: params[:query], placeholder: "e.g. player substitution rules",
            class: "w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent", required: true %>
      </div>

      <div>
        <%= f.label :source_csv, "Filter by rulebook", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :source_csv,
            options_for_select([["All rulebooks", ""]] + @source_csvs.map { |c| [File.basename(c), c] }, params[:source_csv]),
            {}, class: "w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <%= f.submit "Search", class: "bg-blue-600 text-white px-5 py-2 rounded-lg hover:bg-blue-700 cursor-pointer font-medium transition-colors" %>
    <% end %>

    <% if @results&.any? %>
      <h2 class="text-base font-semibold text-gray-600 mb-4"><%= @results.size %> result<%= @results.size == 1 ? "" : "s" %></h2>
      <ul class="space-y-4">
        <% @results.each do |result| %>
          <li class="bg-white border border-gray-200 rounded-xl p-5 shadow-sm">
            <p class="text-xs font-medium text-blue-600 mb-2">
              <% parts = [result[:article], result[:section], result[:rule_number]].compact.reject(&:empty?) %>
              <%= parts.join(" › ") %>
              <span class="ml-2 text-gray-400 font-normal">(score: <%= result[:distance]&.round(4) %>)</span>
            </p>
            <p class="text-gray-800 text-sm whitespace-pre-wrap leading-relaxed"><%= result[:text] %></p>
            <p class="text-xs text-gray-400 mt-3"><%= File.basename(result[:source_csv].to_s) %></p>
          </li>
        <% end %>
      </ul>
    <% elsif params[:query].present? %>
      <p class="text-gray-500">No results found.</p>
    <% end %>
  </div>
</div>
